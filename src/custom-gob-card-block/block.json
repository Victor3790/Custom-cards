{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "create-block/gobmx-card",
	"version": "0.1.0",
	"title": "Gobmx Card",
	"category": "widgets",
	"icon": "embed-generic",
	"description": "Tarjeta de información con diseño Gobmx.",
	"example": {},
	"supports": {
		"html": false
	},
	"textdomain": "gobmx-card",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"attributes": {
		"title":{
			"type": "string",
			"default": "Título de la tarjeta"
		},
		"bullet":{
			"type": "string",
			"default": "1"
		}
	}
}